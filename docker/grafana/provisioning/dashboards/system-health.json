{
  "dashboard": {
    "title": "System Health",
    "tags": ["system", "production", "infrastructure"],
    "timezone": "browser",
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "title": "CPU Usage (%)",
        "type": "gauge",
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "100 - (avg by (instance) (irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "max": 100,
            "min": 0,
            "unit": "percent"
          }
        }
      },
      {
        "title": "Memory Usage (%)",
        "type": "gauge",
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 6,
          "y": 0
        },
        "targets": [
          {
            "expr": "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "max": 100,
            "min": 0,
            "unit": "percent"
          }
        }
      },
      {
        "title": "Disk Usage (%)",
        "type": "gauge",
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "expr": "100 * (1 - (node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "max": 100,
            "min": 0,
            "unit": "percent"
          }
        }
      },
      {
        "title": "Load Average",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 18,
          "y": 0
        },
        "targets": [
          {
            "expr": "node_load1",
            "refId": "A",
            "legendFormat": "1m"
          },
          {
            "expr": "node_load5",
            "refId": "B",
            "legendFormat": "5m"
          },
          {
            "expr": "node_load15",
            "refId": "C",
            "legendFormat": "15m"
          }
        ]
      },
      {
        "title": "Network I/O (Bytes/sec)",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "targets": [
          {
            "expr": "irate(node_network_receive_bytes_total[5m])",
            "refId": "A",
            "legendFormat": "{{device}} in"
          },
          {
            "expr": "irate(node_network_transmit_bytes_total[5m])",
            "refId": "B",
            "legendFormat": "{{device}} out"
          }
        ]
      },
      {
        "title": "Disk I/O (Ops/sec)",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "targets": [
          {
            "expr": "irate(node_disk_reads_completed_total[5m])",
            "refId": "A",
            "legendFormat": "{{device}} reads"
          },
          {
            "expr": "irate(node_disk_writes_completed_total[5m])",
            "refId": "B",
            "legendFormat": "{{device}} writes"
          }
        ]
      }
    ]
  },
  "overwrite": true
}
