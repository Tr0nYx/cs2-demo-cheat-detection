# API endpoint
# Note: For local Docker development, this should be http://localhost:8080/api
# (nginx listens on port 8080 per docker-compose.yml)
# For Docker container-to-container communication, use: http://php:80/api
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Sentry configuration
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_RELEASE=dev
