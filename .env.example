# Application
APP_NAME="CS2 Demo Cheat Detection"
APP_ENV=dev                                    # Use "test" for PHPUnit tests (set in phpunit.xml.dist)
APP_DEBUG=1
APP_SECRET=change-me-in-local-env
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1|next-app)(:[0-9]+)?$'
RESULT_INGEST_TOKEN=change-me-in-local-env

# Docker runtime
APP_UID=1000
APP_GID=1000
NGINX_PORT=8080
NEXT_PORT=3000

# PostgreSQL 16
POSTGRES_DB=cs2_detection
POSTGRES_USER=cs2_app
POSTGRES_PASSWORD=cs2_app_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cs2_app:cs2_app_password@postgres:5432/cs2_detection?serverVersion=16&charset=utf8

# Redis 7
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages
MESSENGER_FAILED_TRANSPORT_DSN=redis://redis:6379/failed

# Queue names
SYMFONY_ANALYSIS_QUEUE=cs2.analysis.dispatch
PYTHON_WORKER_QUEUE=cs2.analysis
RESULT_INGEST_QUEUE=cs2.results

# Demo storage
DEMO_STORAGE_DISK=local
DEMO_STORAGE_PATH=/storage/demos
DEMO_STORAGE_VOLUME=demo_storage
MAX_DEMO_UPLOAD_SIZE=2147483648

# Python worker
PYTHON_ENV=development
PYTHONUNBUFFERED=1
WORKER_IDLE_ON_START=true
WORKER_LOG_LEVEL=INFO
WORKER_POLL_TIMEOUT_SECONDS=5
WORKER_SHUTDOWN_GRACE_SECONDS=15

# Hugging Face / CS2CD dataset
HF_HOME=/app/.cache/huggingface
HF_TOKEN=
CS2CD_DATASET_ID=CS2CD/CS2CD.Counter-Strike_2_Cheat_Detection
CS2CD_DATA_DIR=/data/cs2cd
ANTICHEATPT_MODEL_ID=CS2CD/AntiCheatPT_256

# ML Training Configuration
HF_TOKEN=                                      # HuggingFace token for private dataset access
ML_DATASET_ID=itubrainlab/CS2CD                # HuggingFace dataset identifier
ML_SEED=42                                     # Random seed for reproducibility
ML_AUGMENTATION_SCALE=0.01                     # Gaussian noise scaling factor
ML_OUTPUT_DIR=data/models                      # Directory for trained model checkpoints

# Model Hyperparameters
D_MODEL=128                                    # Transformer hidden size
NHEAD=8                                        # Number of attention heads
NUM_ENCODER_LAYERS=4                           # Number of transformer encoder layers
DROPOUT=0.1                                    # Dropout rate

# Training Hyperparameters
BATCH_SIZE=128                                 # Batch size for training
LEARNING_RATE=0.0001                           # Initial learning rate for AdamW
STEP_SIZE=10                                   # LR scheduler step size (epochs)
GAMMA=0.1                                      # LR scheduler gamma (multiply LR each step)
NUM_EPOCHS=50                                  # Default number of epochs

# HuggingFace Caching
HF_DATASETS_CACHE=~/.cache/huggingface/datasets

# Legacy ML training vars (deprecated, kept for compatibility)
ML_DATA_DIR=/data/ml
ML_CHECKPOINT_DIR=/data/checkpoints
ML_BATCH_SIZE=128
ML_LEARNING_RATE=0.0001
ML_DEVICE=cpu

# Optional future S3-compatible storage
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_PATH_STYLE_ENDPOINT=true

# Optional future observability
PROMETHEUS_ENABLED=false
GRAFANA_ENABLED=false
LOKI_ENABLED=false

# Frontend (Next.js) Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080/api
INTERNAL_API_URL=http://nginx                  # Server-side NextAuth calls from the frontend container to Symfony/nginx
NODE_ENV=development
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_RELEASE=dev

# Authentication (Phase 14: Landing Page + Steam Login)
## Steam OpenID Configuration
STEAM_APP_ID=570                               # Steam App ID (from Steamworks Dashboard; 570 is testing app)
STEAM_API_KEY=                                  # Steam Web API Key (from Steamworks → Your App → Web API Key)

## Next-auth Configuration
NEXTAUTH_SECRET=                                # Generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000             # Frontend URL (http://localhost:3000 for dev, https://yourdomain.com for prod)

## JWT Configuration (Backend)
JWT_SECRET=                                     # Should match NEXTAUTH_SECRET for alignment
STEAM_MATCH_HISTORY_ENCRYPTION_KEY=             # Generate with: openssl rand -base64 32
