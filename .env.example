# Application
APP_NAME="CS2 Demo Cheat Detection"
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change-me-in-local-env
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
RESULT_INGEST_TOKEN=change-me-in-local-env

# Docker runtime
APP_UID=1000
APP_GID=1000
NGINX_PORT=8080

# PostgreSQL 16
POSTGRES_DB=cs2_detection
POSTGRES_USER=cs2_app
POSTGRES_PASSWORD=cs2_app_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cs2_app:cs2_app_password@postgres:5432/cs2_detection?serverVersion=16&charset=utf8

# Redis 7
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages
MESSENGER_FAILED_TRANSPORT_DSN=redis://redis:6379/failed

# Queue names
SYMFONY_ANALYSIS_QUEUE=cs2.analysis.dispatch
PYTHON_WORKER_QUEUE=cs2.analysis
RESULT_INGEST_QUEUE=cs2.results

# Demo storage
DEMO_STORAGE_DISK=local
DEMO_STORAGE_PATH=/storage/demos
DEMO_STORAGE_VOLUME=demo_storage
MAX_DEMO_UPLOAD_SIZE=2147483648

# Python worker
PYTHON_ENV=development
PYTHONUNBUFFERED=1
WORKER_IDLE_ON_START=true
WORKER_LOG_LEVEL=INFO
WORKER_POLL_TIMEOUT_SECONDS=5
WORKER_SHUTDOWN_GRACE_SECONDS=15

# Hugging Face / CS2CD dataset
HF_HOME=/app/.cache/huggingface
HF_TOKEN=
CS2CD_DATASET_ID=CS2CD/CS2CD.Counter-Strike_2_Cheat_Detection
CS2CD_DATA_DIR=/data/cs2cd
ANTICHEATPT_MODEL_ID=CS2CD/AntiCheatPT_256

# ML training
ML_DATA_DIR=/data/ml
ML_CHECKPOINT_DIR=/data/checkpoints
ML_BATCH_SIZE=128
ML_LEARNING_RATE=0.0001
ML_DEVICE=cpu

# Optional future S3-compatible storage
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_PATH_STYLE_ENDPOINT=true

# Optional future observability
PROMETHEUS_ENABLED=false
GRAFANA_ENABLED=false
LOKI_ENABLED=false
